# Copy to .env and change every value before exposing the stack beyond localhost.
# docker compose reads .env automatically; each variable falls back to the dev
# default shown here when unset.

# --- TimescaleDB ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=netwatch_dev_pass
POSTGRES_DB=netwatch

# --- NATS JetStream (one password per role; see nats/nats-server.conf) ---
NATS_CONTROL_PLANE_PASSWORD=dev_cp_pass
NATS_TELEMETRY_AGENT_PASSWORD=dev_agent_pass
NATS_WORKER_CONSUMER_PASSWORD=dev_worker_pass
NATS_READONLY_AUDITOR_PASSWORD=dev_auditor_pass

# --- Control plane ---
# Shared secret nodes present to enroll (Enroll RPC on :50052) for a 24h client cert.
JOIN_TOKEN=netwatch-dev-join-token-2026
# HS256 signing key for REST API tokens; must be identical on both control planes.
JWT_SECRET=netwatch-dev-jwt-secret-2026-change-me-32b
# Bootstrap console admin, created on first start if it does not exist. Sign in to the UI
# with these, then add more users (POST /users) and change this password (PATCH /users/admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=netwatch-admin-dev
